<div class="column is-one-quarter">
  <div class="card" style="height: 100%; display: flex; flex-direction: column;">
    <div class="card-content" style="display: flex; flex-direction: column; height: 100%;">

      <!-- Customer Name -->
      <p class="title is-5 mb-3"><%= customer.full_name %></p>

      <!-- Customer Image -->
      <% if customer.image.attached? %>
        <div class="card-image mb-3" style="text-align: center;">
          <figure class="image is-square" style="width: 100%; height: 160px; overflow: hidden; border-radius: 4px;">
            <%= image_tag customer.image, style: "width: 100%; height: 100%; object-fit: cover;" %>
          </figure>
        </div>
      <% end %>

      <!-- Customer Details -->
      <div class="content" style="margin-top: auto;">
        <% if customer.notes.present? %>
          <p class="is-size-7 mb-2"><strong>Notes:</strong> <%= customer.notes %></p>
        <% end %>
        <p class="is-size-6 mb-1"><strong>Email:</strong> <%= customer.email_address.presence || "Email missing" %></p>
        <p class="is-size-6"><strong>Phone:</strong> <%= customer.phone_number %></p>
      </div>

    </div>
  </div>
</div>